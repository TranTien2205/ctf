{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CTF writeup card",
  "type": "object",
  "required": ["schema_version", "id", "challenge", "classification", "source", "quality"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,160}$"},
    "challenge": {"type": "object", "required": ["name", "category"], "properties": {
      "name": {"type": "string"}, "event": {"type": ["string", "null"]},
      "year": {"type": ["integer", "null"]}, "category": {"type": "string"},
      "points": {"type": ["number", "null"]}, "difficulty": {"type": ["string", "null"]}
    }},
    "classification": {"type": "object", "required": ["primary", "confidence"], "properties": {
      "primary": {"type": "string"}, "secondary": {"type": "array", "items": {"type": "string"}},
      "confidence": {"type": "number", "minimum": 0, "maximum": 1}
    }},
    "signals": {"type": "array", "items": {"type": "string"}},
    "target": {"type": "object", "properties": {
      "interface": {"type": ["string", "null"]}, "endpoints": {"type": "array", "items": {"type": "string"}},
      "parameters": {"type": "array", "items": {"type": "string"}}, "flag_location": {"type": ["string", "null"]}
    }},
    "flow": {"type": "array", "items": {"type": "object", "required": ["stage", "value"]}},
    "first_probe": {"type": ["object", "null"]},
    "exploit": {"type": ["object", "null"]},
    "verification": {"type": ["object", "null"]},
    "pitfalls": {"type": "array", "items": {"type": "string"}},
    "source": {"type": "object", "required": ["url", "retrieved_at", "evidence_spans"], "properties": {
      "url": {"type": "string", "format": "uri"}, "author": {"type": ["string", "null"]},
      "retrieved_at": {"type": "string"}, "evidence_spans": {"type": "array"}
    }},
    "quality": {"type": "object", "required": ["verified_live", "review_status"], "properties": {
      "verified_live": {"type": ["boolean", "string"]},
      "review_status": {"enum": ["raw", "extracted", "reviewed", "rejected"]},
      "extraction_confidence": {"type": "number", "minimum": 0, "maximum": 1}
    }}
  }
}
