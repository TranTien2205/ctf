{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/ctf/chain-schema.json",
  "title": "Verified exploit chain card",
  "description": "A chain this toolkit solved and verified, written so a later challenge with the same observable preconditions can reuse it. It records what was observed and what confirmed it; it never carries a flag, and it is never proof for a new target.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "source_note",
    "challenge",
    "preconditions",
    "signals",
    "chain",
    "first_confirming_probe",
    "blast_radius",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{4,120}$"
    },
    "source_note": {
      "type": "string",
      "description": "Repository-relative path of the solved note this card was derived from. Must exist."
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "category"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "platform": {
          "type": [
            "string",
            "null"
          ]
        },
        "event": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "enum": [
            "web",
            "pwn",
            "rev",
            "crypto",
            "forensics",
            "osint",
            "misc",
            "ai"
          ]
        },
        "solved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "assistance": {
          "enum": [
            "self-solved",
            "writeup-assisted",
            "unknown"
          ]
        }
      }
    },
    "stack": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Observed technologies, lowercase. Used as a matching bonus, never as a requirement."
    },
    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_of"
      ],
      "description": "Plain-language conditions a human must confirm from their own evidence. No tool checks these.",
      "properties": {
        "all_of": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "any_of": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "signals": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      },
      "description": "Literal tokens matched case-insensitively against the observation or the source. Literals, not regexes."
    },
    "chain": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "stage",
          "action"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "stage": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "first_confirming_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "expected",
        "falsifier"
      ],
      "description": "The cheapest reversible action that decides whether this chain applies to the new target.",
      "properties": {
        "request": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        },
        "falsifier": {
          "type": "string"
        }
      }
    },
    "blast_radius": {
      "type": "string",
      "description": "What this chain can damage on a shared instance. Read before any write."
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified_live",
            "writeup-claimed",
            "unverified"
          ]
        },
        "evidence": {
          "type": "string",
          "description": "How the original flag was read. verified_live requires a live response or a supplied artifact."
        }
      }
    },
    "reuse_when": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_traps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Mistakes that cost time or an instance the first time."
    },
    "flag": {
      "type": "null",
      "description": "Always null. Flags are never stored in a card."
    },
    "classification": {
      "type": "object",
      "description": "Which bug class owns this chain. Optional: older cards produced by the writeup pipeline carry it, and it is the only place the secondary classes are recorded.",
      "additionalProperties": false,
      "required": [
        "primary"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "minLength": 1
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
