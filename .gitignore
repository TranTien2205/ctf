# Build and interpreter artifacts
__pycache__/
*.pyc
.venv/
venv/

# Disposable caches and logs
cache/
*.log
*.sqlite3-journal

# Per-run and per-challenge working state; regenerated, and can hold target data
**/runs/
**/state.json
**/baseline.json
!test/baseline.json
build/

# Large vendored binaries: keep them out of history
tools/ghidra-dist/
*.zip
*.tar.gz
*.iso
*.vmdk

# Challenge inputs and artifacts. They are large, often redistributable only by
# the event, and can contain flags. Track one deliberately with
#   git add -f "challenges/<name>"
# scripts/repo_init.sh does exactly that for the Weather App regression fixture.
challenges/
# Media never belongs in history, even inside a force-added challenge
*.gif
*.jpg
*.jpeg
*.png
*.mp4
*.pcap
*.raw
*.dmp

# Secrets: never commit, not even to a private repository
/tmp/
.env
*.token
*.secret
*.pem
*.key
id_rsa*

# Solved notes carry real flags, and knowledge/raw is bulk third-party writeup
# material: both are working-tree context only, never history. Track a specific
# file deliberately with `git add -f` if it must be shared.
solved/
knowledge/raw/

# Regenerable sqlite state: working-tree cache, never history
*.sqlite3
